# ==========================================================================
# ApexBoost - Backend Environment Configuration Example
# ==========================================================================

# Port the Express server will listen on
PORT=3000
PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile human verification
# Keep the secret key server-side only. The site key is safe to expose in HTML.
TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY_HERE
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY_HERE
TURNSTILE_REQUIRED=true

# Cloudflare read-only API for Hermes security checks.
# Token should have Zone:Read and Zone Settings:Read for the ApexBoost zone.
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE
CLOUDFLARE_ZONE_ID=YOUR_CLOUDFLARE_ZONE_ID_HERE

# AI Assistant — OpenAI-compatible Chat Completions provider (e.g. agentrouter, OpenAI).
# Powers the support chat, ticket auto-replies, and dashboard AI predictors.
AI_API_KEY=YOUR_AI_API_KEY_HERE
AI_MODEL=gpt-5.5
AI_BASE_URL=https://agentrouter.org/v1
# Optional full override of the endpoint (defaults to AI_BASE_URL + /chat/completions):
# AI_CHAT_URL=https://agentrouter.org/v1/chat/completions

# OpenClaw website AI Help bridge.
# The bridge runs on the VPS and returns customer-support replies for /api/ai/chat.
OPENCLAW_AGENT_ENABLED=false
OPENCLAW_API_URL=http://72.61.113.82:18790/api/website-ai-help
OPENCLAW_API_TOKEN=CHANGE_THIS_TO_THE_VPS_OPENCLAW_WEBSITE_BRIDGE_TOKEN
OPENCLAW_TIMEOUT_MS=30000
OPENCLAW_TRUSTED_HOSTS=72.61.113.82
# Non-admin website users can receive this many OpenClaw replies per window.
OPENCLAW_REPLY_LIMIT=5
OPENCLAW_REPLY_WINDOW_MS=36000000

# Hermes backend support agent. Store real values only in cPanel/production env.
HERMES_AGENT_ENABLED=true
HERMES_AGENT_NAME=Hermes Agent
HERMES_TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# The bot can only send alerts after the target user/group messages the bot first.
# Use the numeric chat ID from Telegram getUpdates or your bot management tool.
HERMES_TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
# Random private string used in the Telegram webhook URL.
HERMES_TELEGRAM_WEBHOOK_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
# Automatically verify and repair the Telegram webhook when the app starts.
HERMES_TELEGRAM_AUTO_WEBHOOK=true
# Scoped read-only bridge for an external Hermes VPS agent.
# Do not use an admin password or browser session cookie for the agent.

# Operational hardening. Keep backup output outside the public web root.
BACKUP_DIR=/home/apexilvn/backups/apexboost
# MYSQLDUMP_PATH=/usr/bin/mysqldump
# ADMIN_2FA_REQUIRED=true
# ADMIN_REAUTH_MAX_AGE_SECONDS=300
# PROVIDER_CIRCUIT_FAILURE_THRESHOLD=4
# PROVIDER_CIRCUIT_COOLDOWN_MS=60000
HERMES_BRIDGE_ENABLED=false
HERMES_BRIDGE_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
HERMES_BRIDGE_TRUSTED_IPS=72.61.113.82
HERMES_APP_FIREWALL_ENABLED=true
HERMES_APP_FIREWALL_AUTO_BLOCK=true
HERMES_APP_FIREWALL_SCORE_LIMIT=81
HERMES_APP_FIREWALL_RATE_LIMIT=180
HERMES_APP_FIREWALL_BURST_LIMIT=60
# Comma-separated fixed IPs trusted by Hermes. Use only for infrastructure you control.
# Exact IPv4/IPv6 and CIDR ranges are supported.
HERMES_FIREWALL_TRUSTED_IPS=
# Reverse proxies allowed to supply CF-Connecting-IP or X-Forwarded-For.
# Add Cloudflare ranges or your cPanel/Nginx proxy addresses here. Never use 0.0.0.0/0.
HERMES_TRUSTED_PROXY_IPS=
# Add only the exact reverse-proxy/load-balancer IPs or CIDRs that may set
# X-Forwarded-For / CF-Connecting-IP. Loopback is trusted automatically.
# Enables country/ASN enrichment for suspicious IP alerts. If disabled, Hermes only uses proxy headers such as CF-IPCountry/CF-ASN.
HERMES_IP_INTEL_ENABLED=true
HERMES_IP_INTEL_TIMEOUT_MS=2500

# Primary ApexSMM provider secret API key (Placeholder only)
RKD_API_KEY=YOUR_RKD_API_KEY_HERE
# Optional provider endpoint override. Leave default unless your provider gives a different endpoint.
RKD_API_URL=https://rkdpanel.com/api/v2

# Optional ApexSMM secondary provider. Keep real keys only in cPanel/production env, never in source files.
SMMWORLD_API_KEY=YOUR_SMMWORLD_API_KEY_HERE
SMMWORLD_API_URL=https://smmworld.org/api/v2
# Optional filters. SERVICE_IDS are exact imports; KEYWORDS add extra matching services.
SMMWORLD_IMPORT_SERVICE_IDS=
SMMWORLD_IMPORT_KEYWORDS=

# Provider safety controls. Warning is always shown; set block=true to stop live orders below threshold.
PROVIDER_LOW_BALANCE_THRESHOLD_PHP=500
PROVIDER_BLOCK_ORDERS_BELOW_THRESHOLD=false

# Service Markup Multiplier
SERVICE_MARKUP_MULTIPLIER=1.50

# Website display currency
SITE_CURRENCY=PHP
SITE_CURRENCY_SYMBOL=₱

# Exchange Rate (USD to PHP)
USD_TO_PHP_RATE=56.00

# MySQL Connection Configuration (Placeholders only)
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_DB_USER_HERE
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_NAME=YOUR_DB_NAME_HERE

# Outgoing Mail Server (SMTP) Settings (Placeholders only)
EMAIL_HOST=mail.YOURDOMAIN.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=YOUR_EMAIL_USER_HERE
EMAIL_PASS=YOUR_EMAIL_PASS_HERE
SMTP_STARTUP_VERIFY=false
EMAIL_CONNECTION_TIMEOUT_MS=15000
EMAIL_GREETING_TIMEOUT_MS=10000
EMAIL_SOCKET_TIMEOUT_MS=20000
GCASH_ACCOUNT_NUMBER=YOUR_GCASH_NUMBER
GCASH_ACCOUNT_NAME=YOUR_GCASH_NAME
MAYA_ACCOUNT_NUMBER=YOUR_MAYA_NUMBER
MAYA_ACCOUNT_NAME=YOUR_MAYA_NAME
BPI_ACCOUNT_NUMBER=YOUR_BPI_NUMBER
BPI_ACCOUNT_NAME=YOUR_BPI_NAME
BPI_ACCOUNT_TYPE=Savings

# Session and JWT Security Settings (Placeholders only)
JWT_SECRET=YOUR_JWT_SECRET_HERE
SESSION_SECRET=YOUR_SESSION_SECRET_HERE
